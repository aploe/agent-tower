<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms only for the tray icon (NotifyIcon); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentTower</AssemblyName>
    <RootNamespace>AgentTower</RootNamespace>
    <Version>0.1.0</Version>
    <!-- Drawn by scripts/make-icon.mjs. The Start Menu shortcut shows it too. -->
    <ApplicationIcon>AgentTower.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- With both UI stacks on, these implicit usings make Application, Window and Color ambiguous. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
